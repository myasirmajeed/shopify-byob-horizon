{% comment %}
  Section contract.
  Advanced Cart demo storefront: an intro with the active cart offers and a
  grid of merchant-picked products. Each card adds through the AJAX Cart API
  and opens the acx cart drawer (sections/acx-cart-drawer.liquid).
  @example
  <!-- Assigned through templates/page.acx.json on the /pages/advanced-cart page -->
{% endcomment %}

{%- render 'acx-shared-styles' -%}
{%- render 'acx-product-strings' -%}

<div class="acx-scope acx-shop">
  <header class="acx-shop__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="acx-shop__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="acx-shop__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="acx-shop__text">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- liquid
      assign hints = ''
      if section.settings.hint_1 != blank
        assign hints = hints | append: '1'
      endif
      if section.settings.hint_2 != blank
        assign hints = hints | append: '2'
      endif
      if section.settings.hint_3 != blank
        assign hints = hints | append: '3'
      endif
    -%}
    {%- if hints != blank -%}
      <ul class="acx-shop__hints" role="list">
        {%- if section.settings.hint_1 != blank -%}
          <li>{% render 'acx-icon', name: 'truck' %}<span>{{ section.settings.hint_1 | escape }}</span></li>
        {%- endif -%}
        {%- if section.settings.hint_2 != blank -%}
          <li>{% render 'acx-icon', name: 'gift' %}<span>{{ section.settings.hint_2 | escape }}</span></li>
        {%- endif -%}
        {%- if section.settings.hint_3 != blank -%}
          <li>{% render 'acx-icon', name: 'tag' %}<span>{{ section.settings.hint_3 | escape }}</span></li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    <button type="button" class="acx-btn" data-acx-open-cart aria-haspopup="dialog" aria-expanded="false">
      {%- render 'acx-icon', name: 'cart' -%}
      <span>{{ 'acx.view_cart' | t }}</span>
    </button>
  </header>

  {%- if section.settings.products.count > 0 -%}
    <ul class="acx-shop__grid" role="list">
      {%- for product in section.settings.products -%}
        <li>
          {%- render 'acx-product-card',
            product: product,
            section_id: section.id,
            sizes: '(min-width: 1200px) 280px, (min-width: 750px) 30vw, 50vw'
          -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="acx-shop__empty">{{ 'acx.no_products' | t }}</p>
  {%- endif -%}
</div>

<script src="{{ 'acx-products.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .acx-shop {
    display: grid;
    gap: clamp(24px, 4vw, 40px);
    max-width: 1320px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 64px) var(--acx-gutter) clamp(24px, 4vw, 48px);
  }

  .acx-shop__intro {
    display: grid;
    justify-items: start;
    gap: 12px;
    max-width: 720px;
  }

  .acx-shop__eyebrow {
    margin: 0;
    color: var(--acx-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .acx-shop__title {
    margin: 0;
    font-family: var(--acx-serif);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .acx-shop__text {
    color: var(--acx-muted);
    line-height: 1.6;
  }

  .acx-shop__text > * {
    margin: 0;
  }

  .acx-shop__hints {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0;
    padding: 0;
    list-style: none;
  }

  .acx-shop__hints li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--acx-line);
    border-radius: 999px;
    background: var(--acx-paper);
    font-size: 0.875rem;
  }

  .acx-shop__hints .acx-icon {
    color: var(--acx-accent);
  }

  .acx-shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .acx-shop__grid > li {
    display: grid;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .acx-shop__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .acx-shop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .acx-shop__empty {
    padding: 20px;
    border: 1px dashed var(--acx-line-strong);
    border-radius: var(--acx-radius);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:acx.products_name",
  "tag": "section",
  "class": "acx-shopify-section acx-shopify-section--products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:acx.eyebrow", "default": "Advanced cart demo" },
    { "type": "text", "id": "heading", "label": "t:acx.heading", "default": "Brew Bar" },
    { "type": "richtext", "id": "intro", "label": "t:acx.intro" },
    { "type": "product_list", "id": "products", "label": "t:acx.products", "limit": 12 },
    { "type": "header", "content": "t:acx.hints_header" },
    { "type": "text", "id": "hint_1", "label": "t:acx.hint_shipping" },
    { "type": "text", "id": "hint_2", "label": "t:acx.hint_gift" },
    { "type": "text", "id": "hint_3", "label": "t:acx.hint_discount" }
  ],
  "presets": [{ "name": "t:acx.products_name", "category": "t:categories.products" }]
}
{% endschema %}

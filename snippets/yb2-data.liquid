{% doc %}
  Outputs the BYOB 2 catalog (variants, sizes, sleeves, flavors) and interface
  strings as JSON for `<yb2-builder-component>`. Strings with `[name]` placeholders
  are interpolated in JavaScript.

  @param {object} box_product - The box product (options: size, sleeve)
  @param {object} flavors - Product list of flavor products
  @param {object} section - The owning section, for size and sleeve blocks

  @example
  {% render 'yb2-data', box_product: box_product, flavors: flavors, section: section %}
{% enddoc %}

<script type="application/json" ref="catalog">
  {
    "product": { "id": {{ box_product.id | json }}, "title": {{ box_product.title | json }} },
    "variants": [
      {%- for variant in box_product.variants -%}
        {
          "id": {{ variant.id | json }},
          "option1": {{ variant.option1 | json }},
          "option2": {{ variant.option2 | json }},
          "price": {{ variant.price | json }},
          "available": {{ variant.available | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "sizes": [
      {%- assign first_size = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'size' and block.settings.option_value != blank -%}
          {%- unless first_size -%},{%- endunless -%}
          {%- assign first_size = false -%}
          { "value": {{ block.settings.option_value | json }}, "pieces": {{ block.settings.pieces | json }} }
        {%- endif -%}
      {%- endfor -%}
    ],
    "sleeves": [
      {%- assign first_sleeve = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'sleeve' and block.settings.option_value != blank -%}
          {%- unless first_sleeve -%},{%- endunless -%}
          {%- assign first_sleeve = false -%}
          { "value": {{ block.settings.option_value | json }} }
        {%- endif -%}
      {%- endfor -%}
    ],
    "flavors": [
      {%- for flavor in flavors -%}
        {
          "id": {{ flavor.id | json }},
          "title": {{ flavor.title | json }},
          "available": {{ flavor.available | json }},
          "image": {% if flavor.featured_image %}{{ flavor.featured_image | image_url: width: 160, height: 160, crop: 'center' | json }}{% else %}null{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

<script type="application/json" ref="strings">
  {
    "stepOf": {{ 'yb2.step_of' | t: current: '[current]', total: '[total]' | json }},
    "steps": {
      "size": {{ 'yb2.steps.size' | t | json }},
      "flavors": {{ 'yb2.steps.flavors' | t | json }},
      "sleeve": {{ 'yb2.steps.sleeve' | t | json }},
      "review": {{ 'yb2.steps.review' | t | json }}
    },
    "stepCompleted": {{ 'yb2.step_completed' | t | json }},
    "stepCurrent": {{ 'yb2.step_current' | t | json }},
    "stepLocked": {{ 'yb2.step_locked' | t | json }},
    "pieces": {{ 'yb2.pieces' | t: count: '[count]' | json }},
    "counter": {{ 'yb2.counter' | t: count: '[count]', capacity: '[capacity]' | json }},
    "remaining": {{ 'yb2.remaining' | t: count: '[count]' | json }},
    "boxFull": {{ 'yb2.box_full' | t: capacity: '[capacity]' | json }},
    "needMoreOne": {{ 'yb2.need_more.one' | t | json }},
    "needMoreOther": {{ 'yb2.need_more.other' | t: count: '[count]' | json }},
    "tooManyOne": {{ 'yb2.too_many.one' | t: capacity: '[capacity]' | json }},
    "tooManyOther": {{ 'yb2.too_many.other' | t: count: '[count]', capacity: '[capacity]' | json }},
    "complete": {{ 'yb2.complete' | t | json }},
    "chooseSizeFirst": {{ 'yb2.choose_size_first' | t | json }},
    "chooseSleeve": {{ 'yb2.choose_sleeve' | t | json }},
    "included": {{ 'yb2.included' | t | json }},
    "extraPrice": {{ 'yb2.extra_price' | t: price: '[price]' | json }},
    "notSelected": {{ 'yb2.not_selected' | t | json }},
    "resultsOne": {{ 'yb2.results.one' | t | json }},
    "resultsOther": {{ 'yb2.results.other' | t: count: '[count]' | json }},
    "quantityInBox": {{ 'yb2.quantity_in_box' | t: flavor: '[flavor]', count: '[count]' | json }},
    "removeOne": {{ 'yb2.remove_one' | t: flavor: '[flavor]' | json }},
    "trayEmpty": {{ 'yb2.tray_empty' | t | json }},
    "trayLabel": {{ 'yb2.tray_label' | t | json }},
    "continue": {{ 'yb2.continue' | t | json }},
    "addToCart": {{ 'yb2.add_to_cart' | t | json }},
    "adding": {{ 'yb2.adding' | t | json }},
    "errorGeneric": {{ 'yb2.error_generic' | t | json }},
    "errorIncomplete": {{ 'yb2.error_incomplete' | t | json }},
    "errorUnavailable": {{ 'yb2.error_unavailable' | t | json }},
    "addedTitle": {{ 'yb2.added_title' | t | json }},
    "propertyTotal": {{ 'yb2.property_total' | t | json }},
    "propertyFlavor": {{ 'yb2.property_flavor' | t: number: '[number]' | json }}
  }
</script>

{% doc %}
  Step 4 of the BYOB 2 builder: review and add to cart. The section values are
  filled in by `<yb2-builder-component>` from its state; Edit buttons jump back to
  the matching step without clearing anything.

  @example
  {% render 'yb2-step-review' %}
{% enddoc %}

{%- liquid
  assign label_size = 'yb2.review_size' | t
  assign label_flavors = 'yb2.review_flavors' | t
  assign label_sleeve = 'yb2.review_sleeve' | t
-%}

<section class="yb2-step" data-step-panel="review" ref="stepPanels[]" aria-labelledby="Yb2Title-review" hidden>
  <div class="yb2-step__header">
    <h2 class="yb2-step__title" id="Yb2Title-review" tabindex="-1">{{ 'yb2.steps.review' | t }}</h2>
    <p class="yb2-step__intro">{{ 'yb2.step_intros.review' | t }}</p>
  </div>

  <div class="yb2-review">
    <div class="yb2-review__row">
      <div class="yb2-review__content">
        <h3 class="yb2-review__label">{{ 'yb2.review_size' | t }}</h3>
        <p class="yb2-review__value" ref="reviewSize"></p>
      </div>
      <button type="button" class="yb2-review__edit" data-goto="size" on:click="/goToStepFromEvent">
        {%- render 'yb2-icon', name: 'edit' -%}
        <span aria-hidden="true">{{ 'yb2.edit' | t }}</span>
        <span class="visually-hidden">{{ 'yb2.edit_section' | t: section: label_size }}</span>
      </button>
    </div>

    <div class="yb2-review__row">
      <div class="yb2-review__content">
        <h3 class="yb2-review__label">{{ 'yb2.review_flavors' | t }}</h3>
        <ul class="yb2-review__flavors" role="list" ref="reviewFlavors"></ul>
      </div>
      <button type="button" class="yb2-review__edit" data-goto="flavors" on:click="/goToStepFromEvent">
        {%- render 'yb2-icon', name: 'edit' -%}
        <span aria-hidden="true">{{ 'yb2.edit' | t }}</span>
        <span class="visually-hidden">{{ 'yb2.edit_section' | t: section: label_flavors }}</span>
      </button>
    </div>

    <div class="yb2-review__row">
      <div class="yb2-review__content">
        <h3 class="yb2-review__label">{{ 'yb2.review_sleeve' | t }}</h3>
        <p class="yb2-review__value" ref="reviewSleeve"></p>
      </div>
      <button type="button" class="yb2-review__edit" data-goto="sleeve" on:click="/goToStepFromEvent">
        {%- render 'yb2-icon', name: 'edit' -%}
        <span aria-hidden="true">{{ 'yb2.edit' | t }}</span>
        <span class="visually-hidden">{{ 'yb2.edit_section' | t: section: label_sleeve }}</span>
      </button>
    </div>

    <div class="yb2-review__row yb2-review__row--price">
      <div class="yb2-review__content">
        <h3 class="yb2-review__label">{{ 'yb2.review_price' | t }}</h3>
        <dl class="yb2-review__prices">
          <div><dt>{{ 'yb2.box_price' | t }}</dt><dd ref="reviewBoxPrice"></dd></div>
          <div><dt>{{ 'yb2.sleeve_price' | t }}</dt><dd ref="reviewSleevePrice"></dd></div>
          <div class="yb2-review__total"><dt>{{ 'yb2.total' | t }}</dt><dd ref="reviewTotal"></dd></div>
        </dl>
      </div>
    </div>
  </div>

  <div class="yb2-review__cta" ref="reviewCta">
    <button type="button" class="yb2-button yb2-button--wide yb2-button--large" ref="addButton" on:click="/addToCart">
      {%- render 'yb2-icon', name: 'cart' -%}
      <span ref="addLabel">{{ 'yb2.add_to_cart' | t }}</span>
    </button>
    <p class="yb2-error" ref="addError" role="alert" hidden></p>
  </div>

  <div class="yb2-success" ref="success" tabindex="-1" hidden>
    <span class="yb2-success__icon" aria-hidden="true">{%- render 'yb2-icon', name: 'check' -%}</span>
    <div>
      <p class="yb2-success__title">{{ 'yb2.added_title' | t }}</p>
      <p class="yb2-success__body">{{ 'yb2.added_body' | t }}</p>
    </div>
    <div class="yb2-success__actions">
      <button type="button" class="yb2-button" on:click="/viewCart">{{ 'yb2.view_cart' | t }}</button>
      <button type="button" class="yb2-button yb2-button--ghost" on:click="/startOver">{{ 'yb2.build_another' | t }}</button>
    </div>
  </div>
</section>

{% stylesheet %}
  .yb2-review {
    overflow: hidden;
    border: 1px solid var(--yb2-line);
    border-radius: var(--yb2-radius);
    background: var(--yb2-paper);
    box-shadow: var(--yb2-shadow);
  }

  .yb2-review__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px;
  }

  .yb2-review__row + .yb2-review__row {
    border-block-start: 1px solid var(--yb2-line);
  }

  .yb2-review__content {
    display: grid;
    flex: 1;
    gap: 8px;
    min-width: 0;
  }

  .yb2-review__label {
    margin: 0;
    color: var(--yb2-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .yb2-review__value {
    margin: 0;
    font-family: var(--yb2-serif);
    font-size: 1.25rem;
  }

  .yb2-review__flavors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .yb2-review__flavor {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .yb2-review__dot {
    flex: none;
    inline-size: 18px;
    block-size: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--yb2-shell-hi), var(--yb2-shell) 62%);
    box-shadow: inset 0 0 0 3px transparent, 0 1px 2px rgb(0 0 0 / 0.25);
    outline: 2px solid var(--yb2-accent-c);
    outline-offset: -6px;
  }

  .yb2-review__thumb {
    flex: none;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 1px 3px rgb(34 23 15 / 0.2);
  }

  .yb2-review__flavor-name {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .yb2-review__flavor-qty {
    color: var(--yb2-ink-soft);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .yb2-review__edit {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    min-block-size: 40px;
    padding: 0 14px;
    border: 1px solid var(--yb2-line-strong);
    border-radius: 999px;
    background: var(--yb2-paper);
    color: var(--yb2-ink);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .yb2-review__edit:hover {
    border-color: var(--yb2-ink);
  }

  .yb2-review__edit svg {
    inline-size: 14px;
    block-size: 14px;
  }

  .yb2-review__prices {
    display: grid;
    gap: 6px;
    margin: 0;
    max-inline-size: 360px;
  }

  .yb2-review__prices div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .yb2-review__prices dt,
  .yb2-review__prices dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .yb2-review__total {
    padding-block-start: 8px;
    border-block-start: 1px solid var(--yb2-line);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .yb2-review__cta {
    display: grid;
    gap: 10px;
  }

  .yb2-review__cta[hidden] {
    display: none;
  }

  .yb2-button--large {
    min-block-size: 56px;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .yb2-button--large svg {
    inline-size: 18px;
    block-size: 18px;
  }

  .yb2-error {
    margin: 0;
    color: var(--yb2-danger);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .yb2-error[hidden] {
    display: none;
  }

  .yb2-success {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: center;
    padding: 20px;
    border: 1px solid rgb(46 106 76 / 0.3);
    border-radius: var(--yb2-radius);
    background: #f0f7f2;
  }

  .yb2-success[hidden] {
    display: none;
  }

  .yb2-success:focus {
    outline: none;
  }

  .yb2-success__icon {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: var(--yb2-success);
    color: #ffffff;
  }

  .yb2-success__icon svg {
    inline-size: 18px;
    block-size: 18px;
  }

  .yb2-success__title {
    margin: 0;
    font-family: var(--yb2-serif);
    font-size: 1.25rem;
  }

  .yb2-success__body {
    margin: 0;
    color: var(--yb2-ink-soft);
    font-size: 0.875rem;
  }

  .yb2-success__actions {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: 10px;
  }
{% endstylesheet %}

{% doc %}
  Inline stroke icons for the Advanced Cart demo. Decorative: always hidden
  from assistive technology, so the surrounding control must carry the name.

  @param {string} name - close | plus | minus | cart | check | gift | truck | tag | arrow | alert

  @example
  {% render 'acx-icon', name: 'cart' %}
{% enddoc %}
<svg
  class="acx-icon acx-icon--{{ name }}"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 20 20"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case name -%}
    {%- when 'close' -%}
      <path d="M5 5l10 10M15 5L5 15"/>
    {%- when 'plus' -%}
      <path d="M10 4v12M4 10h12"/>
    {%- when 'minus' -%}
      <path d="M4 10h12"/>
    {%- when 'cart' -%}
      <path d="M3 4h2l1.6 8.2a1.5 1.5 0 0 0 1.5 1.2h6.3a1.5 1.5 0 0 0 1.5-1.1L17 7H6"/><circle cx="8.5" cy="16.5" r="1"/><circle cx="14.5" cy="16.5" r="1"/>
    {%- when 'check' -%}
      <path d="M4.5 10.5l3.5 3.5 7.5-8"/>
    {%- when 'gift' -%}
      <rect x="3" y="8" width="14" height="9" rx="1.5"/><path d="M2.5 5.5h15v2.5h-15zM10 5.5V17M10 5.5C8.5 2.5 5.5 3 6 4.8c.3 1 2 .7 4 .7zm0 0c1.5-3 4.5-2.5 4-.7-.3 1-2 .7-4 .7z"/>
    {%- when 'truck' -%}
      <path d="M2 5h10v8H2zM12 8h3.5l2.5 3v2h-6"/><circle cx="5.5" cy="14.5" r="1.5"/><circle cx="14.5" cy="14.5" r="1.5"/>
    {%- when 'tag' -%}
      <path d="M3 3h6.5l7.5 7.5-6.5 6.5L3 9.5z"/><circle cx="6.5" cy="6.5" r="1"/>
    {%- when 'arrow' -%}
      <path d="M4 10h11M11 6l4 4-4 4"/>
    {%- when 'alert' -%}
      <circle cx="10" cy="10" r="7.5"/><path d="M10 6v5M10 14h.01"/>
  {%- endcase -%}
</svg>

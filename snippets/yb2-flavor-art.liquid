{% doc %}
  Renders an original illustrated truffle for a flavor that has no product image.
  Colours come from CSS classes (`yb2-shell--*`, `yb2-accent--*`) defined here,
  so the same palette also drives the box preview slots.

  @param {string} shell - Shell colour: dark, milk or white
  @param {string} top - Topping style: salt, nut, drizzle, dust, flakes, zest or nib
  @param {string} accent - Accent colour name, e.g. caramel, pistachio, mint

  @example
  {% render 'yb2-flavor-art', shell: 'dark', top: 'salt', accent: 'caramel' %}
{% enddoc %}

<svg
  class="yb2-art yb2-shell--{{ shell | default: 'dark' }} yb2-accent--{{ accent | default: 'caramel' }}"
  viewBox="0 0 120 120"
  aria-hidden="true"
  focusable="false"
>
  <ellipse cx="60" cy="96" rx="38" ry="7" fill="rgb(34 23 15 / 0.12)"/>
  <path d="M22 70c0-22 17-40 38-40s38 18 38 40c0 13-17 22-38 22S22 83 22 70z" fill="var(--yb2-shell)"/>
  <path d="M30 62c3-15 15-26 30-26 9 0 17 4 23 11-8-4-16-5-24-3-13 3-23 10-29 18z" fill="var(--yb2-shell-hi)" opacity="0.55"/>
  {%- case top -%}
    {%- when 'salt' -%}
      <g fill="#ffffff" opacity="0.9">
        <rect x="50" y="40" width="5" height="5" transform="rotate(20 52 42)"/>
        <rect x="62" y="37" width="4" height="4" transform="rotate(45 64 39)"/>
        <rect x="70" y="44" width="5" height="5" transform="rotate(10 72 46)"/>
        <rect x="44" y="48" width="4" height="4" transform="rotate(35 46 50)"/>
      </g>
      <path d="M34 70c8 5 44 5 52 0" stroke="var(--yb2-accent-c)" stroke-width="4" stroke-linecap="round" fill="none"/>
    {%- when 'nut' -%}
      <g fill="var(--yb2-accent-c)">
        <path d="M52 34l8-6 7 6-3 8h-9z"/>
        <path d="M40 44l6-3 4 5-4 4-6-1z" opacity="0.85"/>
        <path d="M70 42l6-1 3 6-5 3-4-3z" opacity="0.85"/>
      </g>
    {%- when 'drizzle' -%}
      <path d="M30 56c6-6 10 6 16 0s10 6 16 0 10 6 16 0 10 6 14 0" stroke="var(--yb2-accent-c)" stroke-width="4" stroke-linecap="round" fill="none"/>
      <path d="M32 68c6-6 10 6 16 0s10 6 16 0 10 6 16 0 10 6 12 0" stroke="var(--yb2-accent-c)" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.8"/>
    {%- when 'dust' -%}
      <g fill="var(--yb2-accent-c)">
        <circle cx="48" cy="44" r="2"/><circle cx="58" cy="38" r="2.4"/><circle cx="68" cy="43" r="2"/>
        <circle cx="54" cy="50" r="1.6"/><circle cx="64" cy="52" r="1.8"/><circle cx="74" cy="51" r="1.4"/>
        <circle cx="42" cy="54" r="1.6"/><circle cx="60" cy="45" r="1.4"/>
      </g>
    {%- when 'flakes' -%}
      <g fill="var(--yb2-accent-c)">
        <path d="M44 42l10-3 2 4-10 3z"/><path d="M58 36l9 1-1 4-9-1z"/><path d="M68 44l8 4-2 3-8-4z"/>
        <path d="M50 50l9-1 1 4-9 1z" opacity="0.8"/><path d="M38 54l7-4 2 3-7 4z" opacity="0.8"/>
      </g>
    {%- when 'zest' -%}
      <path d="M42 46c8-10 24-12 36-2" stroke="var(--yb2-accent-c)" stroke-width="5" stroke-linecap="round" fill="none"/>
      <path d="M50 54c6-5 14-5 20 0" stroke="var(--yb2-accent-c)" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.8"/>
    {%- when 'nib' -%}
      <g fill="#2a160c">
        <path d="M46 42l6-2 2 5-6 2z"/><path d="M62 37l5 1-1 5-5-1z"/><path d="M70 47l5 3-3 4-4-3z"/><path d="M52 52l5-1 1 4-5 1z"/>
      </g>
      <path d="M58 30c6 0 10 4 10 9-6 0-10-4-10-9z" fill="var(--yb2-accent-c)"/>
  {%- endcase -%}
</svg>

{% stylesheet %}
  .yb2-art {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* Shell palette */
  .yb2-shell--dark { --yb2-shell: #3a2216; --yb2-shell-hi: #7a4b32; }
  .yb2-shell--milk { --yb2-shell: #7a4a2e; --yb2-shell-hi: #c08a62; }
  .yb2-shell--white { --yb2-shell: #efe2cc; --yb2-shell-hi: #ffffff; }

  /* Accent palette */
  .yb2-accent--caramel { --yb2-accent-c: #d39a4c; }
  .yb2-accent--hazelnut { --yb2-accent-c: #b0773f; }
  .yb2-accent--raspberry { --yb2-accent-c: #c63e63; }
  .yb2-accent--vanilla { --yb2-accent-c: #3b2a20; }
  .yb2-accent--pistachio { --yb2-accent-c: #8fae5a; }
  .yb2-accent--espresso { --yb2-accent-c: #c9a27a; }
  .yb2-accent--coconut { --yb2-accent-c: #f3e3c4; }
  .yb2-accent--peanut { --yb2-accent-c: #d8a35e; }
  .yb2-accent--orange { --yb2-accent-c: #e9822f; }
  .yb2-accent--lavender { --yb2-accent-c: #9a7fc4; }
  .yb2-accent--cinnamon { --yb2-accent-c: #a5582c; }
  .yb2-accent--mint { --yb2-accent-c: #5fae8c; }
{% endstylesheet %}

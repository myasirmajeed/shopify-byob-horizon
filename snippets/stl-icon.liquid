{% doc %}
  Renders a small decorative icon for Shop the Look.

  @param {string} name - One of: plus, minus, close, check, cart, star, arrow

  @example
  {% render 'stl-icon', name: 'plus' %}
{% enddoc %}

{%- case name -%}
  {%- when 'plus' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 3v10M3 8h10"/></svg>
  {%- when 'minus' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 8h10"/></svg>
  {%- when 'close' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>
  {%- when 'check' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8.5 3.2 3L13 4.5"/></svg>
  {%- when 'cart' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 2.5h1.6l1.6 7.5h7.1l1.4-5.5H4.3"/><circle cx="6" cy="13" r="1"/><circle cx="12" cy="13" r="1"/></svg>
  {%- when 'star' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.6l1.9 4.1 4.5.5-3.3 3 .9 4.4L8 11.4l-4 2.2.9-4.4-3.3-3 4.5-.5z"/></svg>
  {%- when 'arrow' -%}
    <svg class="stl-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
{%- endcase -%}
